{
  "tool_name": "retrieve_row_context",
  "version": "0.2",
  "mode": "condition_filter",
  "purpose": "根据结构化条件筛选行，自动返回完整匹配集合的数值列统计，并将可见匹配行合并到 Dynamic Table Context。",
  "tool_call": {
    "tool": "retrieve_row_context",
    "arguments": {
      "mode": "condition_filter",
      "table_name": "users",
      "search_scope": "full_table",
      "conditions": [
        {"column": "users.age", "operator": ">=", "value": 15},
        {"column": "users.age", "operator": "<=", "value": 20}
      ],
      "return_columns": ["users.user_id", "users.age"],
      "top_k": 100
    }
  },
  "tool_output": {
    "matched_rows": {"users": [3, 8, 19]},
    "matched_row_count": {"users": 3},
    "matched_set_statistics": [
      {
        "table_name": "users",
        "column": "age",
        "scope": "all_matched_rows",
        "count": 3,
        "non_null_count": 3,
        "sum": 53,
        "mean": 17.6667,
        "min": 16,
        "max": 19,
        "variance": 1.5556,
        "stddev": 1.2472,
        "parse_coverage": 1.0
      }
    ],
    "visible_row_policy": {
      "top_k": 100,
      "matched_rows_total": 3,
      "visible_rows_returned": 3,
      "truncated": false
    },
    "current_table_context": {
      "context_id": "ctx_001",
      "tables": [
        {
          "table_name": "users",
          "columns": ["user_id", "age"],
          "rows": [3, 8, 19],
          "data": [
            {"_row_id": 3, "user_id": "U003", "age": 16},
            {"_row_id": 8, "user_id": "U008", "age": 19},
            {"_row_id": 19, "user_id": "U019", "age": 18}
          ],
          "source_step_ids": ["step_001"]
        }
      ]
    }
  },
  "state_delta": {
    "dynamic_table_context_changed": true,
    "context_id_before": "ctx_000",
    "context_id_after": "ctx_001",
    "added_rows": {"users": [3, 8, 19]},
    "added_columns": ["users.user_id", "users.age"],
    "static_task_memory_changed": false
  },
  "notes": [
    "所有 retrieve_row_context mode 共享 table_name、search_scope、return_columns 和 top_k。",
    "search_scope 只能是 full_table 或 dynamic_table_context。",
    "condition_filter.conditions 可以包含多个共同构成一个逻辑筛选意图的 predicate。",
    "第一版支持的 operator 为 =、!=、>、>=、<、<=、contains 和 is_numeric。",
    "matched_rows 只列出实际返回给模型的可见匹配行；matched_row_count 覆盖完整匹配集合。",
    "matched_set_statistics 由 harness 自动为 return_columns 中可解析的数值列计算，不需要模型请求。",
    "工具返回的行列始终与现有 Dynamic Table Context 合并。"
  ]
}
