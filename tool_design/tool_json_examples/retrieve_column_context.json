{
  "tool_name": "retrieve_column_context",
  "version": "0.2",
  "purpose": "根据模型明确指定的列，返回固定少量真实样例行，并将这些行列合并到 Dynamic Table Context。",
  "tool_call": {
    "tool": "retrieve_column_context",
    "arguments": {
      "requested_columns": [
        {"table_name": "users", "column": "user_id"},
        {"table_name": "users", "column": "age"}
      ]
    }
  },
  "tool_output": {
    "retrieved_columns": ["users.user_id", "users.age"],
    "sample_row_policy": {
      "type": "fixed_head",
      "num_rows": 2
    },
    "current_table_context": {
      "context_id": "ctx_001",
      "tables": [
        {
          "table_name": "users",
          "columns": ["user_id", "age"],
          "rows": [0, 1],
          "data": [
            {"_row_id": 0, "user_id": "U001", "age": 16},
            {"_row_id": 1, "user_id": "U002", "age": 22}
          ],
          "source_step_ids": ["step_001"]
        }
      ]
    }
  },
  "state_delta": {
    "dynamic_table_context_changed": true,
    "context_id_before": "ctx_000",
    "context_id_after": "ctx_001",
    "added_rows": {"users": [0, 1]},
    "added_columns": ["users.user_id", "users.age"],
    "static_task_memory_changed": false
  },
  "notes": [
    "模型只指定需要查看的列，不传 request_reason、needed_info、reason 或 sample_row_count。",
    "样例行选择策略和数量由 harness 固定，避免模型通过参数扩大上下文。",
    "该工具不返回统计信息，不执行行匹配，也不保证返回最终证据行。",
    "工具返回的行列始终与现有 Dynamic Table Context 合并。"
  ]
}
