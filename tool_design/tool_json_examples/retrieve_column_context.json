{
  "tool_name": "retrieve_column_context",
  "version": "0.1",
  "purpose": "根据模型明确指定的列请求，返回列级信息、少量样例行和数值列统计摘要。",
  "tool_call": {
    "tool": "retrieve_column_context",
    "arguments": {
      "request_reason": "需要筛选 15-20 岁用户，并根据购买强度统计产品类别偏好。",
      "requested_columns": [
        {
          "table_name": "users",
          "column": "age",
          "needed_info": ["sample_values", "numeric_statistics"],
          "reason": "年龄筛选字段"
        },
        {
          "table_name": "users",
          "column": "user_id",
          "needed_info": ["sample_values"],
          "reason": "连接用户与订单"
        },
        {
          "table_name": "orders",
          "column": "product_id",
          "needed_info": ["sample_values"],
          "reason": "连接订单与产品类别"
        },
        {
          "table_name": "orders",
          "column": "purchase_count",
          "needed_info": ["sample_values", "numeric_statistics"],
          "reason": "兴趣或购买强度度量"
        },
        {
          "table_name": "products",
          "column": "category",
          "needed_info": ["sample_values", "value_examples"],
          "reason": "最终需要回答的产品类别"
        }
      ],
      "sample_row_count": 2
    }
  },
  "tool_output": {
    "retrieved_columns": [
      {"table_name": "users", "column": "age", "reason": "年龄筛选字段"},
      {"table_name": "users", "column": "user_id", "reason": "连接用户与订单"},
      {"table_name": "orders", "column": "product_id", "reason": "连接订单与产品类别"},
      {"table_name": "orders", "column": "purchase_count", "reason": "兴趣或购买强度度量"},
      {"table_name": "products", "column": "category", "reason": "最终需要回答的产品类别"}
    ],
    "column_statistics": [
      {
        "table_name": "users",
        "column": "age",
        "semantic_type": "numeric",
        "count": 10000,
        "non_null_count": 9987,
        "parse_coverage": 0.9987,
        "min": 13,
        "max": 78,
        "mean": 34.6,
        "variance": 142.8,
        "stddev": 11.95
      },
      {
        "table_name": "orders",
        "column": "purchase_count",
        "semantic_type": "numeric",
        "count": 50000,
        "non_null_count": 50000,
        "parse_coverage": 1.0,
        "min": 1,
        "max": 74,
        "mean": 3.8,
        "variance": 24.1,
        "stddev": 4.91
      }
    ],
    "sample_row_policy": {
      "type": "fixed_head",
      "num_rows": 2,
      "note": "Column retrieval returns only a small fixed sample for column-level awareness. Matched evidence rows must be retrieved by retrieve_row_context."
    },
    "current_table_context": {
      "context_id": "ctx_002",
      "tables": [
        {
          "table_name": "users",
          "columns": ["user_id", "age"],
          "rows": [0, 1],
          "data": [
            {"_row_id": 0, "user_id": "U001", "age": 16},
            {"_row_id": 1, "user_id": "U002", "age": 22}
          ],
          "source_step_ids": ["step_002"]
        },
        {
          "table_name": "products",
          "columns": ["product_id", "category"],
          "rows": [0, 1],
          "data": [
            {"_row_id": 0, "product_id": "P003", "category": "beauty"},
            {"_row_id": 1, "product_id": "P008", "category": "electronics"}
          ],
          "source_step_ids": ["step_002"]
        }
      ]
    }
  },
  "state_delta": {
    "dynamic_table_context_changed": true,
    "added_columns": ["users.user_id", "users.age", "orders.product_id", "orders.purchase_count", "products.category"],
    "static_task_memory_changed": false
  },
  "notes": [
    "该工具合并列召回和列上下文获取。",
    "模型应明确给出 requested_columns，而不是只给模糊 query。",
    "request_reason 只能作为解释，不应替代具体列请求。",
    "该工具只能返回固定少量样例行用于理解列含义，不应该返回全量行或最终证据行集合。",
    "对于数值列，adapter 应尽量通过预处理返回 min、max、mean、variance/stddev、count 和 parse_coverage 等统计信息。",
    "真正的行匹配、条件过滤和证据行获取必须由 retrieve_row_context 完成。",
    "harness 内部应记录候选列和最终返回列，便于后续分析列检索质量。"
  ]
}
