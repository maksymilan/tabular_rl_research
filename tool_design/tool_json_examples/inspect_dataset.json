{
  "tool_name": "inspect_dataset",
  "version": "0.1",
  "purpose": "获取全局数据集结构，返回表、列、行数和少量样例行，帮助模型建立任务地图。",
  "tool_call": {
    "tool": "inspect_dataset",
    "arguments": {
      "detail_level": "overview",
      "num_sample_rows": 2
    }
  },
  "tool_output": {
    "dataset_overview": {
      "tables": [
        {
          "table_name": "users",
          "num_rows": 10000,
          "columns": ["user_id", "age", "gender", "city"],
          "sample_rows": [
            {"_row_id": 0, "user_id": "U001", "age": 16, "gender": "F", "city": "Shanghai"}
          ]
        },
        {
          "table_name": "orders",
          "num_rows": 50000,
          "columns": ["order_id", "user_id", "product_id", "amount", "order_time"],
          "sample_rows": [
            {"_row_id": 0, "order_id": "O001", "user_id": "U001", "product_id": "P003", "amount": 120}
          ]
        },
        {
          "table_name": "products",
          "num_rows": 2000,
          "columns": ["product_id", "category", "price"],
          "sample_rows": [
            {"_row_id": 0, "product_id": "P003", "category": "beauty", "price": 99}
          ]
        }
      ]
    }
  },
  "state_delta": {
    "dataset_overview_changed": true,
    "dynamic_table_context_changed": false,
    "static_task_memory_changed": false
  },
  "notes": [
    "该工具通常作为任务早期动作使用。",
    "返回样例行只用于全局认知。"
  ]
}
