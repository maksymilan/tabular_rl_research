{
  "tool_name": "aggregate_column",
  "version": "0.1",
  "purpose": "对一个或多个数值列执行聚合计算，例如 count、sum、mean、min、max、variance、stddev。该工具用于避免模型逐行读取和手算。",
  "tool_call": {
    "tool": "aggregate_column",
    "arguments": {
      "table_name": "main_table",
      "target_column": "main_table.tropical cyclones",
      "operations": ["mean", "sum", "count"],
      "row_filter": null,
      "group_by": [],
      "numeric_parse": {
        "remove_commas": true,
        "strip_percent_sign": false
      }
    }
  },
  "tool_output": {
    "aggregation_result": {
      "table_name": "main_table",
      "target_column": "main_table.tropical cyclones",
      "row_filter": null,
      "group_by": [],
      "operations": {
        "count": 10,
        "sum": 106,
        "mean": 10.6
      },
      "parse_report": {
        "input_rows": 10,
        "parsed_numeric_rows": 10,
        "null_or_unparseable_rows": 0,
        "parse_coverage": 1.0
      }
    },
    "result_memory_candidate": {
      "type": "group_result",
      "content": {
        "operation": "mean",
        "column": "main_table.tropical cyclones",
        "count": 10,
        "sum": 106,
        "mean": 10.6
      },
      "supporting_rows_or_columns": {
        "columns": ["main_table.tropical cyclones"],
        "row_filter": null
      },
      "confidence_or_check": "aggregate_column parsed 10 numeric rows and computed sum=106, mean=10.6.",
      "invalidating_condition": "If row_filter changes, parse coverage changes, or additional rows are included, recompute."
    }
  },
  "state_delta": {
    "dynamic_table_context_changed": false,
    "static_task_memory_changed": false,
    "aggregation_result_available": true
  },
  "notes": [
    "该工具是统计/聚合计算工具，不应向模型返回全量行。",
    "row_filter 可为空，也可以引用条件过滤、行检索结果或显式 filter 表达式。",
    "group_by 为空时返回整体聚合；非空时返回分组聚合。",
    "复杂聚合结果应通过 add_to_memory 写入 Static Task Memory。"
  ]
}
